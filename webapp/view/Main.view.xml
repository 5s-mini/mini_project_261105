<mvc:View controllerName="project261105.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns="sap.m">
 	<f:DynamicPage id="dynamicPageId"
				   toggleHeaderOnTitleClick="false">
		<!-- DynamicPage Title -->
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="맛집 리스트"/>
				</f:heading>
			</f:DynamicPageTitle>
		</f:title>

		<!-- DynamicPage Content -->
		<f:content>
			<Table
				id="productsTable"
				itemPress=".onListItemPress"
				inset="false"
				items="{/food}"
				class="sapFDynamicPageAlignContent"
				width="auto"
				mode="MultiSelect"
				sticky="HeaderToolbar,ColumnHeaders"
      			alternateRowColors="true"
				>
				<headerToolbar>
					<OverflowToolbar>
						<SearchField placeholder="메뉴 또는 상호 검색" search=".onSearch" width="15rem"/>
						<ToolbarSpacer/>
						<Button text="랜덤 뽑기" type="Emphasized" icon="sap-icon://synchronize" press=".onRandom" />
						<ToolbarSpacer/>
						<Button text="데이터 추가" type="Accept" press="onAddDialog" />
						<Button text="데이터 삭제" type="Reject" press=".onDelete" />
					</OverflowToolbar>	
				</headerToolbar>
				<columns>
					<Column hAlign="Center">
						<Text text="메뉴" />
					</Column>
					<Column	hAlign="Center">
						<Text text="상호" />
					</Column>
					<Column	hAlign="Center">
						<HBox justifyContent="End" alignItems="Center">
						<Text text="종류" />
						<Button icon="sap-icon://filter" type="Transparent"
               				    press=".onFilter"/>
    					</HBox>
					</Column>
					<Column	hAlign="Center">
						<HBox justifyContent="End" alignItems="Center">
						<Text text="별점" />
						<Button icon="sap-icon://sort" type="Transparent"
               				    press=".onHeaderPress('star')"/>
    					</HBox>
					</Column>
					<Column	hAlign="Center">
						<HBox justifyContent="End" alignItems="Center">
						<Text text="추천 여부" />
						<Button icon="sap-icon://sort" type="Transparent"
               				    press=".onHeaderPress('visit_again')"/>
    					</HBox>
					</Column>    
                    <Column	hAlign="Center">
						<Text text="위치" />
					</Column>                                                           
				</columns>
				<items>
					<ColumnListItem type="Navigation">
						<cells>
							<!--ObjectIdentifier title="{food>Name}" Link="ddddd" /-->
							<Text text="{name}" />
                            <Text text="{store}" />
                            <Text text="{type}" />
							<Text text="{
							   path : 'star',
                       		   formatter : '.formatter.starNumber'
							}" />
							<core:Icon src="{=${visit_again} === true ? 'sap-icon://thumb-up' : 'sap-icon://thumb-down' }"
                               		 color="{=${visit_again} === true ? '#2F9D27' : '#FF0000'}"
                      		/>
                            <Button text="지도 보기" type="Accept" icon="sap-icon://map" press=".onOpenMap" />                         
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</f:content>
	</f:DynamicPage>
</mvc:View>