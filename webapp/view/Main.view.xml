<mvc:View controllerName="project261105.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns="sap.m">
 	<f:DynamicPage id="dynamicPageId"
				   toggleHeaderOnTitleClick="false">
		<!-- DynamicPage Title -->
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="맛집 리스트"/>
				</f:heading>
			</f:DynamicPageTitle>
		</f:title>

		<!-- DynamicPage Content -->
		<f:content>
			<Table
				id="productsTable"
				itemPress=".onListItemPress"
				inset="false"
				items="{/food}"
				class="sapFDynamicPageAlignContent"
				width="auto"
				mode="MultiSelect"
				sticky="HeaderToolbar,ColumnHeaders"
      			alternateRowColors="true"
				>
				<headerToolbar>
					<OverflowToolbar>
						<SearchField placeholder="메뉴 또는 상호 검색" search=".onSearch" width="15rem"/>
						<Button text="랜덤 뽑기" type="Emphasized" icon="sap-icon://synchronize" press=".onRandom" />
						<ToolbarSpacer/>
						<Button text="데이터 추가" type="Accept" icon="sap-icon://add" press="onAddDialog" />
						<Button text="데이터 삭제" type="Reject" icon="sap-icon://delete" press=".onDelete" />
					</OverflowToolbar>	
				</headerToolbar>
				<columns>
					<Column hAlign="Center">
						<Text text="메뉴" />
					</Column>
					<Column	hAlign="Center">
						<Text text="상호" />
					</Column>
					<Column	hAlign="Center" width="8rem">
						<HBox justifyContent="End" alignItems="Center">
						<Text text="종류" />
						<Button icon="sap-icon://filter" type="Transparent"
               				    press=".onFilter"/>
    					</HBox>
					</Column>
					<Column	hAlign="Center">
						<HBox justifyContent="End" alignItems="Center">
						<Text text="별점" />
						<Button icon="sap-icon://sort" type="Transparent"
               				    press=".onHeaderPress('star')"/>
    					</HBox>
					</Column>
					<Column	hAlign="Center" width="8rem">
						<HBox justifyContent="End" alignItems="Center">
						<Text text="재방문 의사" />
						<Button icon="sap-icon://sort" type="Transparent"
               				    press=".onHeaderPress('visit_again')"/>
    					</HBox>
					</Column>    
                    <Column	hAlign="Center">
						<Text text="위치" />
					</Column>                                                           
				</columns>
				<items>
					<ColumnListItem type="Navigation">
						<cells>
							<!--ObjectIdentifier title="{food>Name}" Link="ddddd" /-->
							<ObjectIdentifier title="{name}" />
                            <Text text="{store}" />
                            <HBox alignItems="Center" justifyContent="Center">
								<core:Icon src="sap-icon://meal" size="1rem" class="sapUiTinyMarginEnd"
									color="{= ${type} === '한식' ? '#4CAF50'
											: ${type} === '중식' ? '#FF9800'
											: ${type} === '일식' ? '#2196F3' : '#9C27B0' }"/>
								<Text text="{type}" />
							</HBox>
							<Text text="{
							   path : 'star',
                       		   formatter : '.formatter.starNumber'
							}" />
							<ObjectStatus
								text="{= ${visit_again} ? '또 갈래요!' : '다신 안 가요' }"
								icon="{= ${visit_again} ? 'sap-icon://heart' : 'sap-icon://decline' }"
								state="{= ${visit_again} ? 'Success' : 'Error' }"
								inverted="true"/>
                            <Button text="지도 보기" type="Ghost" icon="sap-icon://map" press=".onOpenMap" />                         
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</f:content>
	</f:DynamicPage>
</mvc:View>