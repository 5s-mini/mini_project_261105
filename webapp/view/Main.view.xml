<mvc:View controllerName="project261105.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns="sap.m">
 	<f:DynamicPage id="dynamicPageId"
				   toggleHeaderOnTitleClick="false">
		<!-- DynamicPage Title -->
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="맛집 리스트"/>
				</f:heading>
			</f:DynamicPageTitle>
		</f:title>

		<!-- DynamicPage Content -->
		<f:content>
			<Table
				id="productsTable"
				mode="SingleSelectMaster"
				itemPress=".onListItemPress"
				inset="false"
				items="{/food}"
				class="sapFDynamicPageAlignContent"
				width="auto">
				<headerToolbar>
					<OverflowToolbar>
						<ToolbarSpacer/>
						<OverflowToolbarButton icon="sap-icon://add" type="Transparent" press=".onAdd"/>
						<OverflowToolbarButton icon="sap-icon://sort" type="Transparent" press=".onSort"/>
					</OverflowToolbar>
				</headerToolbar>
				<columns>
					<Column>
						<Text text="메뉴" />
					</Column>
					<Column	hAlign="Center">
						<Text text="상호" />
					</Column>
					<Column	hAlign="End">
						<HBox justifyContent="End" alignItems="Center">
						<Text text="종류" />
						<Button icon="sap-icon://filter" type="Transparent"
               				    press=".onFilter"/>
    					</HBox>
					</Column>
					<Column	hAlign="End">
						<HBox justifyContent="End" alignItems="Center">
						<Text text="별점" />
						<Button icon="sap-icon://sort" type="Transparent"
               				    press=".onHeaderPress('star')"/>
    					</HBox>
					</Column>
					<Column	hAlign="End">
						<HBox justifyContent="End" alignItems="Center">
						<Text text="추천여부" />
						<Button icon="sap-icon://sort" type="Transparent"
               				    press=".onHeaderPress('visit_again')"/>
    					</HBox>
					</Column>    
                    <Column	hAlign="End">
						<Text text="위치" />
					</Column>                                                           
				</columns>
				<items>
					<ColumnListItem type="Navigation">
						<cells>
							<!--ObjectIdentifier title="{food>Name}" Link="ddddd" /-->
							<Text text="{name}" />
                            <Text text="{store}" />
                            <Text text="{type}" />
							<Text text="{
							   path : 'star',
                       		   formatter : '.formatter.StarCount'
							}" />
							<core:Icon src="{=${visit_again} === true ? 'sap-icon://thumb-up' : 'sap-icon://thumb-down' }"
                               		 color="{=${visit_again} === true ? '#2F9D27' : '#FF0000'}"
                      		/>
                            <Button text="지도" type="Accept" />                            
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</f:content>
	</f:DynamicPage>
</mvc:View>