<mvc:View controllerName="project261105.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns="sap.m">
 	<f:DynamicPage id="dynamicPageId"
				   toggleHeaderOnTitleClick="false">
		<!-- DynamicPage Title -->
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="맛집 리스트"/>
				</f:heading>
			</f:DynamicPageTitle>
		</f:title>

		<!-- DynamicPage Content -->
		<f:content>
			<Table
				id="productsTable"
				mode="SingleSelectMaster"
				itemPress=".onListItemPress"
				inset="false"
				items="{/food}"
				class="sapFDynamicPageAlignContent"
				width="auto">
				<headerToolbar>
					<OverflowToolbar>
						<ToolbarSpacer/>
						<SearchField search=".onSearch" width="17.5rem"/>
						<OverflowToolbarButton icon="sap-icon://add" type="Transparent" press=".onAdd"/>
						<OverflowToolbarButton icon="sap-icon://sort" type="Transparent" press=".onSort"/>
					</OverflowToolbar>
				</headerToolbar>
				<columns>
					<Column>
						<Text text="메뉴" />
					</Column>
					<Column	hAlign="Center">
						<Text text="상호" />
					</Column>
					<Column	hAlign="End">
						<Text text="종류" />
					</Column>
					<Column	hAlign="End">
						<Text text="별점" />
					</Column>
					<Column	hAlign="End">
						<Text text="재방문의사" />
					</Column>    
                    <Column	hAlign="End">
						<Text text="위치" />
					</Column>                                                           
				</columns>
				<items>
					<ColumnListItem type="Navigation">
						<cells>
							<!--ObjectIdentifier title="{food>Name}" text="ddddd" /-->
							<Text text="{name}" />
                            <Text text="{store}" />
                            <Text text="{type}" />
                            <Text text="{star}" />
                            <Text text="{visit_again}" />
                            <Button text="지도 예시용" />                            
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</f:content>
	</f:DynamicPage>
</mvc:View>