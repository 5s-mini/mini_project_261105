<mvc:View controllerName="project261105.controller.Detail"
    xmlns="sap.uxap"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:m="sap.m"
    displayBlock="true"
    height="100%"
    xmlns:core= "sap.ui.core">
    <ObjectPageLayout showTitleInHeaderContent = "true">

    <!-- 페이지 맨 위 제목 영역(항상 보이는 부분)을 넣는 자리 -->
    <headerTitle>
        <!-- 제목 영역에 무엇을 보여줄지 정하는 곳 -->
        <ObjectPageDynamicHeaderTitle>
            <!-- 기본적으로 펼쳐져 있을 때 헤더 -->
            <heading>
            <m:HBox>
                <m:Button icon="sap-icon://nav-back" type="Transparent"
                  tooltip="뒤로가기" press=".onNavButtonPress"
                  class="sapUiTinyMarginEnd"/>

                <m:Title text="{store}" wrapping="true" />
            </m:HBox>
            </heading>

            <!-- 버튼 추가 -->
            <actions>
                <m:Button
						id="AttentionIconButton"
						icon="sap-icon://edit"
						type="Emphasized" 
                        text = "리뷰 수정"
                        press=".onEditBtn"/>
            </actions>

        </ObjectPageDynamicHeaderTitle>
    </headerTitle>

    <!-- 헤더 안쪽 타이틀 밑에 정보들 아래로 내리면 접힘-->
    <headerContent>

        <!-- 헤더 접히는 영역: FlexBox(가로)로 정보 묶음을 나란히 배치, 각 묶음은 VBox(세로), HBox(가로) -->
        <m:FlexBox justifyContent="SpaceBetween" alignItems="Start" width="100%">
            
            <m:HBox >
                <!-- [묶음 1] 썸네일 -->
                <core:Icon src="sap-icon://meal"
                    size="2rem" width="4rem" height="4rem"
                    color="#FFFFFF"
                    backgroundColor="{= ${type} === '한식' ? '#4CAF50'
                                    : ${type} === '중식' ? '#FF9800'
                                    : ${type} === '일식' ? '#2196F3' : '#9C27B0' }"
                    class="sapUiSmallMarginEnd"/>

                <!-- [묶음 2] 기본 정보 -->
                <m:VBox class = "sapUiSmallMarginEnd">
                    <m:Label text="카테고리" design="Bold"/>
                    <m:Text text = "{type}" />
                    <m:Text text = "{name}" />
                </m:VBox>

                <!-- [묶음 3] 정보 -->
                <m:VBox class = "sapUiSmallMarginEnd">
                <m:Label text="별점" design="Bold"/>
                    <m:Text id = "TitleStarText" text="" width="200px"/>
                </m:VBox>
            </m:HBox>

            <!-- [묶음 4] 가성비 점수 정보 --> 
            <m:VBox class="sapUiSmallMarginEnd" alignItems="End" >
                <m:HBox alignItems="Center">
                    <m:Label text="가성비" design="Bold" class="sapUiTinyMarginEnd"/>
                    <core:Icon src="sap-icon://hint" color="Default"
                            tooltip="별점이 높고 가격이 저렴할수록 점수가 높아요"/>
                </m:HBox>
                <m:ProgressIndicator width="200px" showValue="true" 
                        percentValue="{= Math.min(100, ${star} * 2 * 100000 / ${detail/0/price}) }"
                        displayValue="{= Math.round(Math.min(100, ${star} * 2 * 100000 / ${detail/0/price})) }점"
                        state="{= ${star} * 2 * 100000 / ${detail/0/price} >= 75 ? 'Success'
                            : ${star} * 2 * 100000 / ${detail/0/price} >= 40 ? 'Warning' : 'Error' }"/>
            </m:VBox>
        </m:FlexBox>
    </headerContent>

<!--
        본문 영역 (스크롤해서 내려보는 부분)
        구조: ObjectPageSection(섹션) → subSections → ObjectPageSubSection(서브섹션) → blocks(실제 내용)
        - 섹션 title = 앵커 바 버튼 이름 / 섹션이 2개 이상이면 앵커 바가 자동 생성됨
        - 내용은 섹션에 바로 못 넣고 반드시 서브섹션의 blocks 안에 넣어야 함
        - 서브섹션에 title이 없으면 섹션 제목만 표시됨
        - titleUppercase="false" : 제목을 대문자로 바꾸지 않음
    -->

    <sections>

        <!-- 먹은 음식 -->
        <ObjectPageSection titleUppercase="false" id="goals" title="먹은 음식">
        <ObjectPageSubSection>
            <blocks>
						<m:Text text = "{detail/0/menu}"/>
			</blocks>
        </ObjectPageSubSection>
        </ObjectPageSection>

        <!-- 가격 -->
        <ObjectPageSection titleUppercase="false" title="가격">
            <ObjectPageSubSection>
                <blocks>
					<m:Text text="{
                    path : 'detail/0/price',
                    type : 'sap.ui.model.type.Integer',
                    formatOptions : { groupingEnabled : true }
                    }원" /> <!-- detail 안의 → 0번째의 → price”, 즉 가격을 정수(Integer) 타입으로 다루고 세자리마다 묶어서 표시(groupingEnabled)한다 -->
			    </blocks>
            </ObjectPageSubSection>
        </ObjectPageSection>

        <!-- 음식 사진 (src에 이미지 URL 또는 webapp 기준 경로) -->
        <ObjectPageSection titleUppercase="false" title="사진">
            <ObjectPageSubSection>
                <blocks>
					<m:Image src ="{image}" width="30%" backgroundSize="cover" backgroundPosition="center"/>
			    </blocks>
            </ObjectPageSubSection>
        </ObjectPageSection>

        <!--평가 -->
        <ObjectPageSection titleUppercase="false" title="평가">
            <ObjectPageSubSection>
                <m:HBox alignItems="Start">
                    <core:Icon src="sap-icon://feedback" size="2rem" color="#5D5D5D" class="sapUiSmallMarginEnd"/>
                    <m:Text text="{detail/0/review}"/>
                </m:HBox>
            </ObjectPageSubSection>
        </ObjectPageSection>

        <!-- 재방문 의사 -->
        <ObjectPageSection titleUppercase="false" title="재방문 의사">
            <ObjectPageSubSection>
                <blocks>
					<m:ObjectStatus
                        text="{= ${visit_again} ? '또 갈래요!' : '다신 안 가요' }"
                        icon="{= ${visit_again} ? 'sap-icon://heart' : 'sap-icon://decline' }"
                        state="{= ${visit_again} ? 'Success' : 'Error' }"
                        inverted="true"/>
			    </blocks>
            </ObjectPageSubSection>
        </ObjectPageSection>

        <!-- 별점 평균 -->
        <ObjectPageSection titleUppercase="false" title="별점">
            <ObjectPageSubSection>
                <blocks>
					<m:Title id = "starMean" text="" titleStyle="H2"/>
                    <m:VBox>
                    <m:Title  text = "별점 평균"/>
                    <m:Title id = "starRateText" text = "" titleStyle="H3"/>
                    </m:VBox>

			    </blocks>
            </ObjectPageSubSection>
        </ObjectPageSection>

        <!-- || => 값이 있으면 오른쪽 내용 표시 --> 
        <ObjectPageSection titleUppercase="false" title="댓글 목록 ({= ${comments/length} || 0 })">
            <ObjectPageSubSection>
                <blocks>
                    <m:VBox>
                        <m:HBox alignItems="Center" class="sapUiSmallMarginBottom">
                        <m:Select id = "starRate" width="10rem" selectedKey = "5" class="sapUiTinyMarginEnd">
                            <core:Item key="1" text="★☆☆☆☆ (1점)"/>
                            <core:Item key="2" text="★★☆☆☆ (2점)"/>
                            <core:Item key="3" text="★★★☆☆ (3점)"/>
                            <core:Item key="4" text="★★★★☆ (4점)"/>
                            <core:Item key="5" text="★★★★★ (5점)"/>
                        </m:Select>
                            <m:Input id="commentName" width="8rem" placeholder="닉네임"/> 
                            <m:Input id="commentInput" width="20rem" placeholder="댓글을 입력하세요" class="sapUiTinyMarginEnd"/>
                            <m:Button text="등록" icon="sap-icon://paper-plane" type="Emphasized" press="onCommentPress"/>
                        </m:HBox >
                        <m:Table id="commentTable" items="{comments}" noDataText="아직 댓글이 없어요. 첫 댓글을 남겨주세요!" alternateRowColors="true">                                               <!-- 🔧 (I) -->
                            <m:columns>
                                <m:Column width="10rem"><m:Text text="별점" /></m:Column>                  <!-- 🔧 (J) -->
                                <m:Column width="10rem"><m:Text text="닉네임" /></m:Column>                <!-- 🔧 (J) -->
                                <m:Column><m:Text text="댓글" /></m:Column>                                <!-- 그대로 -->
                            </m:columns>
                            <m:items>
                                <m:ColumnListItem>
                                    <m:cells>
                                        <!--ObjectIdentifier title="{food>Name}" Link="ddddd" /-->
                                        <m:Text text="{
                                        path : 'CommentStar',
                                        formatter : '.formatter.starNumber'
                                        }" />
                                        <m:HBox alignItems="Center">
                                            <core:Icon src="sap-icon://customer" size="1.2rem" color="Neutral" class="sapUiTinyMarginEnd"/>
                                            <m:Text text="{name}" />
                                        </m:HBox>
                                        <m:Text text="{comment}" />                         
                                    </m:cells>
                                </m:ColumnListItem>
                            </m:items>
                        </m:Table>
                    </m:VBox>
	            </blocks>
            </ObjectPageSubSection>
        </ObjectPageSection>
    </sections>

    </ObjectPageLayout>
</mvc:View>