<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:f="sap.ui.layout.form"
	xmlns:core="sap.ui.core">
	<Dialog id="idDialog" contentWidth="500px">
		<content>
			<f:SimpleForm
				editable="true"
				layout="ColumnLayout"
				columnsM="2"
				columnsL="2"
				columnsXL="2">
				<f:content>
					<core:Title text="음식 정보" />

					<Label text="먹었던 음식" />
					<Input id="idname" value="{/name}" width="350px" placeholder="Ex) 햄버거" />

					<Label text="음식점 상호명" />
					<Input id="idstore" value="{/store}" width="350px" placeholder="Ex) 맥도날드 구로디지털단지역점" />

					<Label text="분류" />
					<Select id="idtype" forceSelection="false" width="200px" >
                        <items>
							<core:Item key="한식" text="한식" /> 
							<core:Item key="중식" text="중식" />
							<core:Item key="일식" text="일식" />
							<core:Item key="양식" text="양식" />
                        </items>
                    </Select>

					<Label text="별점" />
					<Select id="idstars" forceSelection="false" width="200px" >
                        <items>
							<core:Item key="1" text="★☆☆☆☆" /> 
							<core:Item key="2" text="★★☆☆☆" />
							<core:Item key="3" text="★★★☆☆" />
							<core:Item key="4" text="★★★★☆" />
							<core:Item key="5" text="★★★★★" />
                        </items>
                    </Select>

					<Label text="재방문 의사" />
					<Select id="idrevisit" forceSelection="false" width="200px" >
                        <items>
							<core:Item key="true" text="O" /> 
							<core:Item key="false" text="X" />
                        </items>
                    </Select>

					<Label text="음식 이미지 URL" />
					<Input id="idimgurl" value="{edit>/age}" width="400px" placeholder="Ex) https:// ..."/>

					<core:Title text="세부사항" />

					<Label text="메뉴" />
					<Input id="idmenu" value="{edit>/age}" width="350px" placeholder="Ex) 베이컨 토마토 디럭스 세트"/>

					<Label text="가격" />
					<Input id="idprice" value="{edit>/grade_level}" width="350px" placeholder="숫자만 입력해주세요 Ex) 8700 "/>

					<Label text="후기" />
					<TextArea id="idreview" value="{edit>/grade_level}" width="400px" height="100px" placeholder="Ex) 내부가 협소하고 시끄럽다... 매장 청결관리가 잘 되어있다..."/>

				</f:content>
			</f:SimpleForm>
		</content>
		<footer>
			<Toolbar>
				<content>
					<ToolbarSpacer />
					<Button id="idDialogBtn"  press=".onSaveDialogBtn" />
					<Button text="닫기" press=".onCloseDialogBtn" />
				</content>
			</Toolbar>
		</footer>
	</Dialog>
</core:FragmentDefinition>