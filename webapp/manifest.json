{
  "_version": "1.90.0",
  "sap.app": {
    "id": "project261105",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.34.0",
      "toolsId": "1801b0ae-b38d-4ac8-aea6-3d253c4a397e"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.154.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.f": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "project261105.i18n.i18n"
        }
      },
      "": {
        "type": "sap.ui.model.json.JSONModel",
        "uri": "model/data.json"
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlId": "app",
        "controlAggregation": "pages",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "project261105.view",
        "async": true
      },
      "routes": [
        { "name": "RouteMain", "pattern": "", "target": ["TargetMain"] },
        { "name": "RouteDetail", "pattern": "detail/{paramId}", "target": ["TargetDetail"] }
      ],
      "targets": {
        "TargetMain": { "id": "Main", "name": "Main", "level": 1 },
        "TargetDetail": { "id": "Detail", "name": "Detail", "level": 2 }
      }
    },
    "rootView": {
      "viewName": "project261105.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
